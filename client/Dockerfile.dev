FROM node:20.11.0-alpine

WORKDIR /app

# Install dependencies first (leveraging cache)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy the rest of the source code
COPY . .

EXPOSE 3000

# Run the Next.js development server with polling enabled 
# (polling is often required for file-watching to detect changes reliably inside Docker volumes on Linux/Windows)
CMD ["npm", "run", "dev"]